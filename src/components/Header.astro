---
import SocialLinks from './SocialLinks';
import ThemeToggle from './ThemeToggle';
import { SITE } from '../lib/site';

interface Props {
  sticky?: boolean;
}

const { sticky = true } = Astro.props;
---

<header class:list={['bg-background', sticky && 'sticky top-0 z-40']}>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-6 py-4">
    <a href="/" class="group flex flex-col">
      <span class="font-brand text-2xl font-bold tracking-tight text-ink transition-colors group-hover:text-terracotta">
        {SITE.name}
      </span>
      <span class="hidden font-mono text-xs text-muted sm:block">{SITE.tagline}</span>
    </a>

    <div class="flex items-center gap-2">
      <SocialLinks />
      <div class="mx-1 hidden h-6 w-px bg-line sm:block" />
      <ThemeToggle client:load />
    </div>
  </div>
  <div class="hatch h-2 opacity-60" aria-hidden="true"></div>
</header>
