---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { readingTime } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const minutes = readingTime(post.body ?? '');
const fullDate = post.data.date.toLocaleDateString('pt-BR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.description} stickyHeader={false}>
  <div class="mx-auto max-w-[1400px] px-6 py-10 sm:px-8">
    <article class="mx-auto max-w-[760px]">
      <header>
        <a
          href="/"
          class="font-mono text-xs uppercase tracking-wider text-muted transition-colors hover:text-terracotta"
        >
          ← Todos os artigos
        </a>

        <h1 class="mt-4 font-brand text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">
          {post.data.title}
        </h1>

        <p class="mt-4 text-lg leading-relaxed text-muted">{post.data.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-2">
          <span class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-olive">
            {post.data.topic || post.data.category}
          </span>
          <span class="font-mono text-xs text-muted">{fullDate}</span>
          <span class="font-mono text-xs text-muted">·</span>
          <span class="font-mono text-xs text-muted">{minutes}</span>
          <span class="font-mono text-xs text-muted">·</span>
          <span class="font-mono text-xs text-muted">{post.data.category}</span>
        </div>

        {
          post.data.stack.length > 0 && (
            <div class="mt-3 flex flex-wrap items-center gap-1.5">
              {post.data.stack.map((s) => (
                <span class="rounded-md border border-line px-2 py-0.5 font-mono text-xs text-ink">
                  {s}
                </span>
              ))}
            </div>
          )
        }

        <div class="hatch h-2 mt-6 opacity-60" aria-hidden="true"></div>
      </header>

      <div class="article-body mt-10">
        <Content />
      </div>
    </article>

    <footer class="mx-auto mt-16 max-w-[760px]">
      <div class="hatch h-2 mb-6 opacity-60" aria-hidden="true"></div>
      <a href="/" class="font-mono text-xs text-muted transition-colors hover:text-terracotta">
        ← Voltar para os artigos
      </a>
    </footer>
  </div>
</BaseLayout>
