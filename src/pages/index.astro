---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogExplorer from '../components/BlogExplorer';
import { getSortedPosts, listOf, listOfStack, listOfTags, toCardData } from '../lib/posts';

const posts = await getSortedPosts();
const cards = posts.map(toCardData);
const groups = {
  categories: listOf(posts, 'category'),
  topics: listOfTags(posts),
  stack: listOfStack(posts),
};
---

<BaseLayout>
  <div class="mx-auto max-w-[1400px] px-6 py-10 sm:px-8">
    <BlogExplorer client:load posts={cards} groups={groups} />
  </div>
</BaseLayout>
